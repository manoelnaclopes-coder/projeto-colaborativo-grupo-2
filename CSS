*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-color: grey;
}
    

body{
    background-color: white;
}

.interface{
    max-width: 1280px;
    margin: 0 auto;
}

.flex{
    display: flex;
}

header{
    padding: 40px 4%;
}

header > .interface{
    display: flex;
    align-items: center;
    justify-content: space-between; /*alinha tudo deixando o  ultimo na ponta direita eo primeiro na esquerda */
}

header a{
    color: black;
    text-decoration: none;
    display: inline-block;
    transition: 100ms;
}

/*da a animação de aumentar quando passa o mause por cima*/
header a:hover{
    color: black;
    transform: scale(1.2);

}

/*tira os pontinhos*/
header nav ul{
    list-style: none;
}

/*deixa o inicio,aulas,meu pg em linha e separa eles */
header nav ul li{
    display: inline-block;
    padding: 0px 60px;
}

.btn-entrar button{
    padding: 10px 50px;
    font-size: 20px;
    font-weight: 600;
    background-color: rgba(2, 194, 66, 0.867);
    border: 0;
    border-radius: 30px;
    cursor: pointer;
    transition: .2s;
}

.btn-cadastro button{
    padding: 10px 50px;
    font-size: 20px;
    font-weight: 600;
    background-color: rgba(2, 194, 66, 0.867);
    border: 0;
    border-radius: 30px;
    cursor: pointer;
    transition: .2s;
}

h2.titulo{
    color: #fff;
    font-size: 3px;
    text-align: center;
}

.materias{
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin: 20px auto;
    border: 0;
    border-radius: 30px;
    transition: .2s;
    margin-left: 300px;
}

.card2,.card3{
    width: 500px;
    border: 2px solid #ccc;
    border-radius: 30px;
    overflow: hidden;
    transition: .2s;
}

.card-img-top,.card-img-top2,.card-img-top3{
    width: 100%;
    height: 200px;
    display: block;
    border: 0;
    border-radius: 30px;
    transition: .2s;
}

