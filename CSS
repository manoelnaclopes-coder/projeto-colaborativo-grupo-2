body {
    border: 0;
    padding: 0;
    margin: 0;
    background-color: var(--fundo) !important; /*o inportante serve para dizer que essa cor é prioridade pois o botstrap tem sua cor definida*/
}

:root{
    --barras_btn: #22c55e;
    --fundo: #c9dbf2;
    --letras: #000000;
    --pesquisa: #c0bebe;
    --letra_B: #ffffff;
    --loguin: #c9dbf2;
    --sombra: rgba(128, 128, 128, 0.224);
}

body.dark-mode{
    --barras_btn: #22c55e;
    --fundo: #000000;
    --letras: #ffffff;
    --pesquisa: #c0bebe;
    --letra_B: white;
}

/*logo*/
.logo img {
    border: 0;
    border-radius: 20px;
    margin-left: 50px;
}

/*startintch*/
.logo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.logo h2{
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 30px;
    color: var(--letras);
    font-weight: 700;  /*deixa o texto em negrito*/
    line-height: 1.2;   /*diminui o espaço entre as linhas */
}
/* alinhar header e animar */


header .interface {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    height: 80px;
}

header ul {
    display: flex;  /* aqui ele deixou as letras alinhadas*/
    list-style: none;   /* tirou todas bolinhas das letras*/
    gap: 100px;  /* deu um espaço entre as letras*/
    font-size: 19px;
    margin-top: 15px;
}

header a {
    text-decoration: none;  /* aqui tira a linha de baixo */
    color: var(--letras);
    transition: .43s;
}

header .navegacao a:hover {  /* aqui seleciona em especifico o navegacao a*/
    background-color: rgba(128, 128, 128, 0.224);
    border-radius: 30px;
    padding: 5px 10px;
}

header .botoes {  /* aqui estou selecionando botoes dentro do header*/
    display: flex;  /* alinhou os botoes*/
    align-items: center;
    gap: 10px;  /* deu um espaçamento entre os botoes*/
}

/*estilizar o entrar*/
.btn-cor button {
    background-color: transparent;
    color: var(--letras);
    border-radius: 50%;
    padding: 1px 2px;
    border: 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
}

.btn-cor{
    margin-right: 10px;
}

.btn-entrar {
    transition: .3s;
}

.btn-entrar:hover {  /*hover estiliza o botaõ quendo vc passa em cima*/
    transform: scale(1.1);

}

.btn-entrar button {
    background-color: var(--barras_btn);
    border-radius: 10px;
    padding: 5px 20px;
    border: 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    margin-right: 20px;
    
}
.btn-entrar button{
    color: var(--letras);
}



/*barra que separa o header*/
header {
    box-shadow: 1px  2px var(--barras_btn);  /*o (0) é que a sombra não vasa eo (2) é que a sombra vai 2px para baixo*/
}

/* arrumar a barra de pesquisa */
.pesquisa {
    display: flex;
    background-color: var(--pesquisa);
    border-radius: 20px;
    align-items: center;
    width: 300px;
    padding: 5px 15px;
    width: 230px;
}

/*aqui vai mudar onde o usuario escreve*/
.pesquisa input {
    border: none;  /*tira a borda preta*/
    background: transparent;  /*usa o fundo cinza que ja tem*/
    outline: none;   /*tirou as linhas em volta da escrita*/
    width: 100%;   /*vai o culpar o espaço maximo*/
    font-size: 14px;
    color:var(--letras);
}

/*placeholder é para autera cor, fonte ou opacidade*/
.pesquisa input::placeholder {
    color: var(--pesquisa);
}

.pesquisa span {
    font-size: 20px;
    color:var(--barras_btn);
    font-weight: bold;  /*bold significa 700 deixa o span mais grosso*/
    cursor: pointer;
    margin-left: 5px;
}

/*alinhar o texto do topo */
main .topo {
    padding-left: 100px;

}

main .txt-topo h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 48px;
    color: var(--letras);
    font-weight: 700;  /*deixa o texto em negrito*/
    line-height: 1.2;   /*diminui o espaço entre as linhas */
    margin-bottom: 20px;  /*aqui ele afasta o paragrafo de baixo*/
    font-style: italic;
    margin-top: 50px;
}

.quebrar-linha{
    display: block;
}

.quebrar-linha span{
    color: var(--barras_btn);
    font-style: italic;
}

main .txt-topo p {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    color:  var(--letras);
    line-height: 1.4;   /*da espaço entre as linhas*/
    max-width: 450px;   /* limita o texto ficar muito comprido*/
    margin-bottom: 30px;  /*afasta o botão de baixo*/
}

/*imagen do lado do textinho*/
.flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.img-direita img{
    max-width:100%;
    height: auto;
    border-radius: 16px;
    margin-bottom: auto;
    margin-bottom: 40px;

}

.img-direita{
    margin-right: 30px;
}

/*botão esplicando como funciona o site*/
.bt-sobre button{
    color: var(--letras);
    background-color: var(--barras_btn);
    border-radius: 10px;
    height: 40px;
    width: 180px;
    margin-bottom: 100px;
}

.bt-sobre span{
    font-size: 20px;
}
/*aqui cria uma barra verde */
section {
    box-shadow: 1px  80px  var(--barras_btn);  /*o (0) é que a sombra não vasa eo (2) é que a sombra vai 2px para baixo*/
}
/*informaçoes dentro da barra*/
.barra{
    display: flex; 
    font-size: 19px;
    gap: 180px; /* deu um espaço entre as letras*/
    margin-left: 100px;
    margin-top: 20px;
    margin-bottom: 1px;
    color:  var(--letra_B);
    font-weight: 700;
}
/*Parte dos Materiais*/
/* Container pai de todos os cards */
.materias {
    padding: 20px 10px;
    margin-left: 50px; /* Alinha com o resto do seu layout */
    color: var(--letras);
}

/* Agrupa os cards lado a lado usando Flexbox */
.materias .card {
    display: flex;
    flex-direction: row;      /* Se não couber na tela, pula pra linha de baixo */
    gap: 30px;             /* Espaço de 30px entre cada card */
    background: transparent; /* Remove o fundo branco padrão do Bootstrap se estiver atrapalhando */
    border: none;          /* Remove borda do container pai */ 
    margin-top: 30px;
    margin-left: 75px;
}

/* Estilo individual para cada card (card1 e card2) */
.card1, .card2 {
    width: 300px;          /* Define uma largura fixa ideal para o card */
    background-color:var(--letra_B); /* Define a cor de fundo do card */
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); /* Deixa o card elevado e bonito */
    overflow: hidden;      /* Garante que a imagem respeite as bordas arredondadas */
    display: flex;
    flex-direction: column;
    border: solid rgba(0, 0, 0, 0.375);
}

/* Ajusta as imagens dentro dos cards para não vazarem */
.card-img-top2 {
    width: 100%;
    height: 180px;         /* Define uma altura fixa padrão para as fotos */
    object-fit: cover;     /* Corta a imagem com qualidade sem distorcer */
    border: solid rgba(0, 0, 0, 0.375);
}


/* Ajusta o espaçamento interno do texto dos cards */
.card-body {
    padding: 15px;
}

footer{
    background-color: var(--barras_btn);
    color: var(--letras);
    padding: 30px;
    margin-top: 100px;

}
/*nuda cor e formato do btn de cor */

.btn-cor{
    background-color: none;
    color: var(--letras);
    border-radius: 10px;
    padding: 5px 20px;
    border: 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
}

.modal-login {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color:transparent;
    z-index: 1000; /*garante que fique por cima de tudo*/
    justify-content: center;
    align-items:center ;
}

.modal-login form{
    background-color: var(--letra_B);
    padding: 30px;
    border-radius: 8px;
    width: 400px;
    position: relative;
    box-shadow: 0 4px 10px var(--barras_btn);
}

.mb-3 input{
    border: 1px solid rgba(0, 0, 0, 0.607);
}

.btn-login button{
    color: black;
    background-color: #22c55e;
    border-radius: 10px;
    height: 40px;
    width: 70px;
    gap: 100px;
}

.botoes{
    display: flex;
    
}
